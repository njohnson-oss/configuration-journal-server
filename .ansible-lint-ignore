# Known, deliberate deviations from the production profile. Anything not
# listed here fails CI. Remove an entry once the code no longer needs it.

# ansible.builtin.git cannot create a bare repository with --object-format.
roles/cgit/tasks/main.yml command-instead-of-module

# common holds the values every role shares, so their names are those
# roles', not common_*. ansible_managed is Ansible's own name.
roles/common/vars/main.yml var-naming[no-role-prefix]
roles/common/defaults/main.yml var-naming[no-role-prefix]

# addresses holds the names the server publishes and where their keys
# are, which the roles publishing them share, so their names are those
# roles', not addresses_*.
roles/addresses/defaults/main.yml var-naming[no-role-prefix]

# The website and cgit both send the HSTS header the caddy role builds,
# so its setting is named for the web, as web_domain is.
roles/caddy/defaults/main.yml var-naming[no-role-prefix]

# The stale public key and hostname must be gone before tor restarts, and
# only for the services whose key changed. A handler could do it too; kept
# as a task so the deletion stays next to the key copy that requires it.
roles/tor/tasks/main.yml no-handler
