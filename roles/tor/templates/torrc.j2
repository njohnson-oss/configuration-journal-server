# {{ ansible_managed }}
# This instance is a pure onion service host: no SOCKS port, no client use.

SocksPort 0
Log {{ tor_log }}
DataDirectory {{ tor_data_dir }}

# {{ onion_hostname }}
HiddenServiceDir {{ tor_service_dir }}
HiddenServiceVersion 3
{% for port in tor_onion_ports %}
HiddenServicePort {{ port }}
{% endfor %}
