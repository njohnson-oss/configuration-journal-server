# {{ ansible_managed }}
# Vhosts live in {{ caddy_sites_dir }} and are written by the role that
# owns the service. This file holds global options and shared snippets.

{
	email {{ acme_email }}
	http_port {{ web_http_port }}
	https_port {{ web_https_port }}
	servers {
		protocols {{ caddy_protocols | join(' ') }}
	}
	# Every logger that sees a request is under http: access, handler
	# errors, the reverse proxy and Go's own server. Leaving them all out
	# logs no request, failed or not. Caddy's own operation, certificates
	# included, is still logged.
	log {
		output file {{ caddy_log }}
		level {{ caddy_log_level }}
		exclude http
	}
}

(pq_tls) {
	tls {
		protocols {{ tls_protocol_min }} {{ tls_protocol_max }}
{% if tls_curves %}
		curves {{ tls_curves | join(' ') }}
{% endif %}
	}
}

# Headers that are safe on every transport. HSTS is deliberately absent:
# it is meaningless over .onion/.i2p and is set per-vhost on the TLS sites.
(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Strict-Transport-Security, for the TLS sites only.
(hsts) {
	header Strict-Transport-Security "max-age={{ caddy_hsts_max_age }}{{ '; includeSubDomains' if web_hsts_include_subdomains else '' }}"
}

import {{ caddy_sites_dir }}/*.caddy
