# {{ ansible_managed }}

# ── Clearnet ──────────────────────────────────────────────────────────
{{ ([web_domain] + web_aliases) | join(', ') }} {
	import pq_tls
	import security_headers
	header Strict-Transport-Security "{{ website_hsts }}"

	root * {{ website_root }}
	file_server {
		index {{ website_index | join(' ') }}
	}
	encode zstd gzip

	log {
		output discard
	}
}

# ── Tor and I2P ───────────────────────────────────────────────────────
# Plain HTTP bound to the loopback: both networks encrypt the transport
# themselves and the address *is* the key, so TLS would add nothing and
# HSTS would be wrong here.
http://{{ onion_hostnames[web_onion_service] }}:{{ web_hidden_port }}, http://{{ i2p_addresses[web_i2p_tunnel] }}:{{ web_hidden_port }} {
	bind 127.0.0.1
	import security_headers

	root * {{ website_root }}
	file_server {
		index {{ website_index | join(' ') }}
	}
	encode zstd gzip

	log {
		output discard
	}
}
