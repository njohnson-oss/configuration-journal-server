# {{ ansible_managed }}

# ── Clearnet ──────────────────────────────────────────────────────────
{{ ([web_domain] + web_aliases) | join(', ') }} {
	import pq_tls
	import security_headers
	header Strict-Transport-Security "{{ website_hsts }}"
	header Onion-Location "http://{{ onion_hostname }}{uri}"

	root * {{ website_root }}
	file_server {
		index {{ website_index | join(' ') }}
	}
	encode zstd gzip

	log {
		output discard
	}
}

# ── Tor and I2P ───────────────────────────────────────────────────────
# Plain HTTP: both networks encrypt the transport themselves and the
# address *is* the key, so TLS would add nothing and HSTS would be wrong
# here.
http://{{ onion_hostname }}, http://{{ i2p_addresses.web }} {
	import security_headers

	root * {{ website_root }}
	file_server {
		index {{ website_index | join(' ') }}
	}
	encode zstd gzip

	log {
		output discard
	}
}
