# {{ ansible_managed }}

# ── Clearnet ──────────────────────────────────────────────────────────
{{ web_domain }} {
	import pq_tls
	import security_headers
	import hsts
	header Onion-Location "http://{{ addresses_onion_hostname }}{uri}"

	root * {{ website_root }}
	file_server {
		index {{ website_index | join(' ') }}
	}
	encode zstd gzip

	log {
		output discard
	}
}

{% if web_aliases %}
# The aliases, such as www, redirect to web_domain, so the site has one
# address. They keep the TLS policy and HSTS, which browsers apply per
# name.
{{ web_aliases | join(', ') }} {
	import pq_tls
	import security_headers
	import hsts
	redir https://{{ web_domain }}{uri} permanent

	log {
		output discard
	}
}

{% endif %}
# ── Tor and I2P ───────────────────────────────────────────────────────
# Plain HTTP: both networks encrypt the transport themselves and the
# address *is* the key, so TLS would add nothing and HSTS would be wrong
# here.
http://{{ addresses_onion_hostname }}, http://{{ addresses_i2p.web }} {
	import security_headers

	root * {{ website_root }}
	file_server {
		index {{ website_index | join(' ') }}
	}
	encode zstd gzip

	log {
		output discard
	}
}
