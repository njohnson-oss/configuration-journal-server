# {{ ansible_managed }}

# The site's files, served the same on every transport.
(website_files) {
	root * {{ website_root }}
	file_server {
		index {{ website_index | join(' ') }}
	}
	encode zstd gzip

	# A missing page gets the site's own error page, when it has one,
	# still with status 404. Without one, Caddy's empty 404 is sent.
	# The error routes run apart from the ones above, so they compress
	# the page themselves.
	handle_errors 404 {
		@error_page file {{ website_error_page }}
		handle @error_page {
			rewrite * {{ website_error_page }}
			file_server
			encode zstd gzip
		}
	}
}

# ── Clearnet ──────────────────────────────────────────────────────────
{{ web_domain }} {
	import pq_tls
	import security_headers
	import hsts
	header Onion-Location "http://{{ addresses_onion_hostname }}{uri}"

	import website_files

	log {
		output discard
	}
}

{% if web_aliases %}
# The aliases, such as www, redirect to web_domain, so the site has one
# address. They keep the TLS policy and HSTS, which browsers apply per
# name.
{{ web_aliases | join(', ') }} {
	import pq_tls
	import security_headers
	import hsts
	redir https://{{ web_domain }}{uri} permanent

	log {
		output discard
	}
}

{% endif %}
# ── Tor and I2P ───────────────────────────────────────────────────────
# Plain HTTP: both networks encrypt the transport themselves and the
# address *is* the key, so TLS would add nothing and HSTS would be wrong
# here.
http://{{ addresses_onion_hostname }}, http://{{ addresses_i2p.web }} {
	import security_headers

	import website_files

	log {
		output discard
	}
}
