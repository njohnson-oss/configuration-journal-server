# {{ ansible_managed }}
# Agate takes all of its configuration on the command line, so this unit
# is the configuration. Gemini is port {{ gemini_port }}, above 1024, so
# nothing here ever needs to be root and no privilege drop is involved.
#
# --log-ip is deliberately absent. Without it Agate writes "-" where the
# peer address would go, in request and TLS-error lines alike.

[Unit]
Description=Agate Gemini server
Documentation=https://github.com/mbrubeck/agate
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User={{ gemini_user }}
Group={{ gemini_group }}
ExecStart={{ gemini_binary }} \
{% for address in gemini_listen_addresses %}
	--addr {{ address }} \
{% endfor %}
{% for host in gemini_hostnames %}
	--hostname {{ host }} \
{% endfor %}
	--content {{ (gemini_hostnames | length > 1) | ternary(gemini_root, gemini_content_dir) }} \
	--certs {{ gemini_cert_dir }} \
	--lang {{ gemini_lang }}{% if gemini_only_tls13 %} \
	--only-tls13
{% endif %}

Restart=on-failure
RestartSec=5s

# The certificates and the capsule are the only things it reads, and it
# writes nothing: the keys are generated by Ansible, not by Agate. If a
# certificate ever went missing Agate would try to generate one in its
# place; under ProtectSystem=strict that write fails and the unit stops.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProtectKernelLogs=true
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077
RemoveIPC=true
PrivateUsers=true

[Install]
WantedBy=multi-user.target
